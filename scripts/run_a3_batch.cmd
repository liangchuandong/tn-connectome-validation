@echo off
rem ============================================================================
rem  A3 batch resume launcher  (ASCII only on purpose)
rem
rem  WHY THIS EXISTS
rem  ---------------
rem  The A3 pipeline is a multi-day job (193 subjects x ~42 min ~= 5.6 days with
rem  a single worker). The machine cannot stay on continuously, so the job WILL
rem  be interrupted by shutdowns. This script makes resuming a one-liner.
rem
rem  RESUMABILITY GUARANTEES
rem  -----------------------
rem  Re-running is always safe and idempotent:
rem    * completed segmentations are skipped  (~32 min saved each)
rem    * completed registrations are skipped  (~9 min saved each)
rem    * completed subjects are skipped entirely (~1 min saved each)
rem    * files truncated by a power loss are DETECTED by integrity checks
rem      (size + readability + shape) and REDONE, so they never silently
rem      contaminate results
rem  Worst case loss on shutdown: the single subject being processed (~42 min).
rem
rem  USAGE
rem  -----
rem      scripts\run_a3_batch.cmd            -> process all eligible subjects
rem      scripts\run_a3_batch.cmd A          -> only group A list
rem      scripts\run_a3_batch.cmd B          -> only group B list
rem
rem  The subject lists are generated by the helper that wrote a3_subjects.txt.
rem  Eligible = has both T1w and T2w (193 of 238 directories).
rem ============================================================================
setlocal EnableExtensions EnableDelayedExpansion

chcp 65001 >nul 2>&1

set "SCRIPT_DIR=%~dp0"
set "PROJ_DIR=%SCRIPT_DIR%.."
set "RAW=F:\ds005713\raw"
set "WORK=%PROJ_DIR%\build\work"
set "OUT=%PROJ_DIR%\build\derivatives"
set "DEST=F:\ds005713\derivatives"
set "LICENSE=%PROJ_DIR%\build\license.txt"
set "LOGDIR=%PROJ_DIR%\build\download_logs"

rem ---- interpreter ----
set "PY=F:\venvs\tnwt\Scripts\python.exe"
if not exist "%PY%" (
  echo [ERR] analysis venv not found: %PY%
  exit /b 2
)

rem ---- license is REQUIRED for registration ----
if not exist "%LICENSE%" (
  echo [ERR] FreeSurfer license missing: %LICENSE%
  echo       Get one free: https://surfer.nmr.mgh.harvard.edu/registration.html
  exit /b 2
)

rem ---- subject list ----
set "GROUP=%~1"
if /i "%GROUP%"=="A" ( set "LIST=%PROJ_DIR%\build\a3_groupA.txt" ) else (
if /i "%GROUP%"=="B" ( set "LIST=%PROJ_DIR%\build\a3_groupB.txt" ) else (
  set "LIST=%PROJ_DIR%\build\a3_subjects.txt" ))
if not exist "%LIST%" (
  echo [ERR] subject list not found: %LIST%
  echo       regenerate it with the helper in scripts\run_a3_pipeline.py docs
  exit /b 2
)

if not exist "%WORK%"  mkdir "%WORK%"  2>nul
if not exist "%OUT%"   mkdir "%OUT%"   2>nul
if not exist "%LOGDIR%" mkdir "%LOGDIR%" 2>nul

rem ---- child temp must be writable (DSH sandbox temp is not) ----
set "TMPDIR=%PROJ_DIR%\build\tmp"
if not exist "%TMPDIR%" mkdir "%TMPDIR%" 2>nul
set "TEMP=%TMPDIR%"
set "TMP=%TMPDIR%"
set "PYTHONIOENCODING=utf-8"
set "OMP_NUM_THREADS=4"

rem ---- disk safety gate: refuse to start below 20 GB free on C: ----
rem NOTE: do NOT parse `dir /-c | findstr "bytes free"`: findstr treats the
rem space as an OR so both "File(s)" and "Dir(s)" lines match, and any fixed
rem token index then yields "Dir(s)" rather than the byte count (verified).
set "FREEGB="
for /f "usebackq delims=" %%F in (`powershell -NoProfile -Command "[int]((Get-PSDrive C).Free/1GB)"`) do set "FREEGB=%%F"
if not defined FREEGB (
  echo [ABORT] Could not determine free space on C:.
  exit /b 4
)
if %FREEGB% LSS 20 (
  echo.
  echo [ABORT] C: free space is %FREEGB% GB, below the 20 GB safety threshold.
  exit /b 3
)

echo.
echo ===================== A3 batch (resumable) =====================
echo   python   : %PY%
echo   raw      : %RAW%
echo   work     : %WORK%
echo   out      : %OUT%
echo   dest     : %DEST%
echo   subjects : %LIST%
echo   threads  : 4    (single worker: host RAM is tight, do NOT parallelise)
echo   free C:  : %FREEGB% GB
echo =================================================================
echo.
echo   Safe to stop at any time. Re-run this same script to resume.
echo.

"%PY%" -u "%SCRIPT_DIR%run_a3_pipeline.py" ^
  --raw "%RAW%" ^
  --work "%WORK%" ^
  --out "%OUT%" ^
  --dest "%DEST%" ^
  --fs-license "%LICENSE%" ^
  --subjects-file "%LIST%" ^
  --threads 4 --timeit 2>&1 | powershell -NoProfile -Command "$input | Tee-Object -FilePath (Join-Path '%LOGDIR%' ('a3_batch_' + (Get-Date -Format yyyyMMdd_HHmmss) + '.log'))"
set "CODE=%ERRORLEVEL%"

echo.
if "%CODE%"=="0" (
  echo [OK] batch finished.  logs: %LOGDIR%
) else (
  echo [WARN] batch exited with code %CODE%  logs: %LOGDIR%
  echo        Re-run this script to resume; completed subjects are skipped.
)
exit /b %CODE%
